{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FURU Tic-Tac-Toe Game Database Schema",
  "description": "Schema definition for Firebase Firestore Cloud Database",
  "collections": {
    "users": {
      "description": "User profile, authentication, wallet, and daily tournament plays",
      "documentId": "{uid} (Firebase Auth UID)",
      "fields": {
        "uid": { "type": "string", "description": "Firebase Auth unique ID" },
        "displayName": { "type": "string", "description": "Public name shown in game and leaderboard" },
        "email": { "type": "string", "description": "User email address" },
        "photoURL": { "type": "string", "nullable": true, "description": "Google profile avatar image URL" },
        "isGoogleUser": { "type": "boolean", "default": true, "description": "True for Google Authenticated players, false for guests" },
        "coins": { "type": "integer", "default": 100, "description": "In-game virtual coin balance (initial 100)" },
        "dailyPlays": {
          "type": "object",
          "description": "Map of UTC dates (YYYY-MM-DD) to count of tournament matches played (max 5/day)",
          "additionalProperties": { "type": "integer" }
        },
        "lastLogin": { "type": "timestamp" },
        "lastActive": { "type": "timestamp" }
      }
    },
    "tournaments": {
      "description": "Current 3-Day cycle status, active countdown, and Reigning Champion",
      "documentId": "current_cycle",
      "fields": {
        "cycleId": { "type": "string", "example": "cycle_1772635200000" },
        "startTime": { "type": "timestamp", "description": "Cycle start timestamp" },
        "endTime": { "type": "timestamp", "description": "Cycle end timestamp (startTime + 72 hours)" },
        "reigningChampion": {
          "type": "object",
          "nullable": true,
          "properties": {
            "uid": { "type": "string" },
            "name": { "type": "string" },
            "photoURL": { "type": "string" },
            "score": { "type": "integer" },
            "cycleWon": { "type": "string" }
          }
        }
      }
    },
    "leaderboard": {
      "description": "Active 3-Day Tournament player rankings (Only verified Google users)",
      "documentId": "{uid} (Firebase Auth UID)",
      "fields": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "score": { "type": "integer", "description": "Tournament points earned in current cycle (+25 win, +5 draw, -5 loss)" },
        "photoURL": { "type": "string", "nullable": true },
        "matchesWon": { "type": "integer" },
        "matchesPlayed": { "type": "integer" },
        "isGoogleUser": { "type": "boolean", "const": true },
        "updatedAt": { "type": "timestamp" }
      }
    }
  }
}
