rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 👤 User Profiles & Live Player Tracking
    match /users/{userId} {
      // Allow reading user profiles (for display names, live status & rankings)
      allow read: if true;
      
      // Allow user to create and update their own document
      allow write: if request.auth != null && (request.auth.uid == userId || request.resource.data.uid == request.auth.uid);
      allow create, update: if request.resource.data.displayName is string || request.resource.data.name is string;
    }

    // 🏆 Official Leaderboard (Strict Access Control: Only verified Google users)
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId && request.resource.data.isGoogleUser == true;
    }

    // 🏆 3-Day Tournament Cycles & Reigning Champion
    match /tournaments/{cycleDoc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
